{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "0.1.0",
  "identifier": "com.sriponrama.nova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA",
        "width": 450,
        "height": 700,
        "minWidth": 350,
        "minHeight": 500,
        "resizable": true,
        "center": true
      },
      {
        "title": "NOVA Companion",
        "label": "companion",
        "width": 300,
        "height": 450,
        "minWidth": 250,
        "minHeight": 300,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
